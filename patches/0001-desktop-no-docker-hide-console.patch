+package runtime
+
+import (
+	"testing"
+
+	"agentflow/internal/domain"
+)
+
+func TestDesktopHostRuntime(t *testing.T) {
+	t.Setenv("LOOPFORGE_DESKTOP", "")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "")
+	if desktopHostRuntime() {
+		t.Fatal("expected host runtime off by default")
+	}
+	t.Setenv("LOOPFORGE_DESKTOP", "1")
+	if !desktopHostRuntime() || !DesktopHostRuntime() {
+		t.Fatal("LOOPFORGE_DESKTOP=1 should enable host runtime")
+	}
+	t.Setenv("LOOPFORGE_DESKTOP", "")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "true")
+	if !desktopHostRuntime() {
+		t.Fatal("AGENTFLOW_DISABLE_DOCKER=true should enable host runtime")
+	}
+}
+
+func TestIsolateLocalDriverOnDesktop(t *testing.T) {
+	t.Setenv("LOOPFORGE_DESKTOP", "1")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "")
+	for _, driver := range []string{"docker", "native", "bwrap", "seatbelt"} {
+		p, _ := isolateLocalDriver(domain.SandboxProfile{Driver: driver}, domain.DockerfileDefinition{})
+		if p.Driver != "local" {
+			t.Fatalf("desktop should remap %s to local, got %s", driver, p.Driver)
+		}
+	}
+}
