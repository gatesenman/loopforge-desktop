-// isolateLocalDriver runs "local" profiles in Docker when
-// AGENTFLOW_LOCAL_SANDBOX=docker, so no SOP command executes inside a platform
-// container that can reach the host Docker daemon.
+// desktopHostRuntime is set by the LoopForge desktop shell: every sandbox
+// runs on the host (SQLite, no Docker). Docker/native/bwrap/seatbelt profiles
+// are rewritten to the local driver so the shipped product never starts a container.
+// DesktopHostRuntime reports whether this process must run without Docker
+// (LoopForge desktop shell or AGENTFLOW_DISABLE_DOCKER=1).
+func DesktopHostRuntime() bool { return desktopHostRuntime() }
+
+func desktopHostRuntime() bool {
+	v := strings.TrimSpace(os.Getenv("LOOPFORGE_DESKTOP"))
+	if v == "1" || strings.EqualFold(v, "true") {
+		return true
+	}
+	v = strings.TrimSpace(os.Getenv("AGENTFLOW_DISABLE_DOCKER"))
+	return v == "1" || strings.EqualFold(v, "true")
+}
+
+// isolateLocalDriver remaps sandbox drivers for the current deployment.
+// On the desktop build, all isolation drivers become "local". In Compose,
+// AGENTFLOW_LOCAL_SANDBOX=docker still wraps bare "local" profiles in Docker.
 func isolateLocalDriver(profile domain.SandboxProfile, dockerfile domain.DockerfileDefinition) (domain.SandboxProfile, domain.DockerfileDefinition) {
 	driver := strings.TrimSpace(profile.Driver)
+	if desktopHostRuntime() {
+		switch driver {
+		case "docker", "native", "bwrap", "seatbelt":
+			profile.Driver = "local"
+		}
+		return profile, dockerfile
+	}
 	if (driver != "" && driver != "local") || strings.TrimSpace(os.Getenv("AGENTFLOW_LOCAL_SANDBOX")) != "docker" {
 		return profile, dockerfile
 	}
diff --git a/internal/runtime/sandbox_docker_desktop_test.go b/internal/runtime/sandbox_docker_desktop_test.go
new file mode 100644
index 0000000..423de2a
--- /dev/null
+++ b/internal/runtime/sandbox_docker_desktop_test.go
@@ -0,0 +1,35 @@
+package runtime
+
+import (
+	"testing"
+
+	"agentflow/internal/domain"
+)
+
+func TestDesktopHostRuntime(t *testing.T) {
+	t.Setenv("LOOPFORGE_DESKTOP", "")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "")
+	if desktopHostRuntime() {
+		t.Fatal("expected host runtime off by default")
+	}
+	t.Setenv("LOOPFORGE_DESKTOP", "1")
+	if !desktopHostRuntime() || !DesktopHostRuntime() {
+		t.Fatal("LOOPFORGE_DESKTOP=1 should enable host runtime")
+	}
+	t.Setenv("LOOPFORGE_DESKTOP", "")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "true")
+	if !desktopHostRuntime() {
+		t.Fatal("AGENTFLOW_DISABLE_DOCKER=true should enable host runtime")
+	}
+}
+
+func TestIsolateLocalDriverOnDesktop(t *testing.T) {
+	t.Setenv("LOOPFORGE_DESKTOP", "1")
+	t.Setenv("AGENTFLOW_DISABLE_DOCKER", "")
+	for _, driver := range []string{"docker", "native", "bwrap", "seatbelt"} {
+		p, _ := isolateLocalDriver(domain.SandboxProfile{Driver: driver}, domain.DockerfileDefinition{})
+		if p.Driver != "local" {
+			t.Fatalf("desktop should remap %s to local, got %s", driver, p.Driver)
+		}
+	}
+}
