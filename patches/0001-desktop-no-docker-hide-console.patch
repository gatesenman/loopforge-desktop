@@ -0,0 +1,43 @@
+package repo
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestOpenSQLiteSeedsStarterCatalog(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "db", "loopforge.db")
+	s, err := Open("sqlite:" + path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.StorageInfo()["driver"]; got != "sqlite" {
+		t.Fatalf("driver = %v", got)
+	}
+	if _, ok := s.Project("welcome"); !ok {
+		t.Fatal("welcome project missing")
+	}
+	d, ok := s.Dockerfile("generic-backend")
+	if !ok || !strings.Contains(d.Content, "\nRUN apt-get") {
+		t.Fatalf("generic-backend dockerfile escapes not converted: %q", d.Content)
+	}
+	sb, ok := s.Sandbox("generic-docker")
+	if !ok || sb.Driver != "local" {
+		t.Fatalf("desktop seed should remap docker sandbox to local, got %+v ok=%v", sb, ok)
+	}
+	s.Close()
+	// Reopening an existing database must not fail or reseed.
+	s, err = Open("sqlite:" + path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.Close()
+}
+
+func TestMySQLSeedToSQLite(t *testing.T) {
+	got := mysqlSeedToSQLite("SET NAMES utf8mb4;\nSTART TRANSACTION;\n-- c;\nINSERT IGNORE INTO t (a,b) VALUES ('x\\\\ny; it\\'s',UTC_TIMESTAMP());\nCOMMIT;")
+	if len(got) != 1 || !strings.HasPrefix(got[0], "INSERT OR IGNORE INTO t") || !strings.Contains(got[0], `'x\ny; it''s'`) || strings.Contains(got[0], "UTC_TIMESTAMP") {
+		t.Fatalf("%q", got)
+	}
+}
