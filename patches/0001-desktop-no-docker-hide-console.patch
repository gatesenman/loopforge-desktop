@@ -0,0 +1,23 @@
+//go:build windows
+
+package runtime
+
+import (
+	"os/exec"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+// hideCommandWindow prevents a console or Windows Terminal tab from flashing
+// when a console-subsystem tool (docker.exe, git.exe, cmd.exe) is started.
+func hideCommandWindow(cmd *exec.Cmd) {
+	if cmd == nil {
+		return
+	}
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.HideWindow = true
+	cmd.SysProcAttr.CreationFlags |= windows.CREATE_NO_WINDOW
+}
