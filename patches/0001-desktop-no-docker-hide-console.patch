--- /dev/null
+++ b/internal/osx/osx.go
@@ -0,0 +1,17 @@
+// Package osx holds the small set of process, file-lock and file-identity
+// primitives that differ between Unix and Windows, so the rest of the code
+// base can build for the LoopForge desktop (Windows) package unchanged.
+package osx
+
+import "errors"
+
+// ErrLocked reports that a non-blocking exclusive lock is held elsewhere.
+var ErrLocked = errors.New("file is locked by another process")
+
+// FileID is the portable subset of a stat result.
+type FileID struct {
+	Dev   uint64
+	Ino   uint64
+	Uid   uint32
+	Nlink uint64
+}
diff --git a/internal/osx/osx_unix.go b/internal/osx/osx_unix.go
new file mode 100644
index 0000000..69f296f
--- /dev/null
+++ b/internal/osx/osx_unix.go
@@ -0,0 +1,62 @@
+//go:build !windows
+
+package osx
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"syscall"
+)
+
+// SetProcessGroup starts cmd in its own process group.
+func SetProcessGroup(cmd *exec.Cmd) {
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.Setpgid = true
+}
+
+// HasProcessGroup reports whether SetProcessGroup was applied to cmd.
+func HasProcessGroup(cmd *exec.Cmd) bool {
+	return cmd.SysProcAttr != nil && cmd.SysProcAttr.Setpgid
+}
+
+// KillGroup force-kills the process group led by pid.
+func KillGroup(pid int) error { return syscall.Kill(-pid, syscall.SIGKILL) }
+
+// TerminateGroup asks the process group led by pid to exit.
+func TerminateGroup(pid int) error { return syscall.Kill(-pid, syscall.SIGTERM) }
+
+// HangupGroup sends SIGHUP to the process group led by pid.
+func HangupGroup(pid int) error { return syscall.Kill(-pid, syscall.SIGHUP) }
+
+// Alive reports whether pid names a live process (EPERM counts as alive).
+func Alive(pid int) bool {
+	err := syscall.Kill(pid, 0)
+	return err == nil || errors.Is(err, syscall.EPERM)
+}
+
+// Signalable reports whether this process may signal pid.
+func Signalable(pid int) bool { return syscall.Kill(pid, 0) == nil }
+
+// TryLock takes a non-blocking exclusive lock; ErrLocked when held elsewhere.
+func TryLock(f *os.File) error {
+	err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if err == syscall.EWOULDBLOCK || err == syscall.EAGAIN {
+		return ErrLocked
+	}
+	return err
+}
+
+// Unlock releases a lock taken by TryLock.
+func Unlock(f *os.File) error { return syscall.Flock(int(f.Fd()), syscall.LOCK_UN) }
+
+// Identity returns the device/inode/owner/link-count of info.
+func Identity(info os.FileInfo) (FileID, bool) {
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return FileID{}, false
+	}
+	return FileID{Dev: uint64(st.Dev), Ino: uint64(st.Ino), Uid: st.Uid, Nlink: uint64(st.Nlink)}, true
+}
diff --git a/internal/osx/osx_windows.go b/internal/osx/osx_windows.go
new file mode 100644
index 0000000..58b6310
--- /dev/null
+++ b/internal/osx/osx_windows.go
@@ -0,0 +1,97 @@
+//go:build windows
+
+package osx
+
+import (
+	"errors"
+	"hash/fnv"
+	"os"
+	"os/exec"
+	"strconv"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+// SetProcessGroup starts cmd in a new process group with no console window.
+func SetProcessGroup(cmd *exec.Cmd) {
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.CreationFlags |= windows.CREATE_NEW_PROCESS_GROUP | windows.CREATE_NO_WINDOW
+	cmd.SysProcAttr.HideWindow = true
+}
+
+// HasProcessGroup reports whether SetProcessGroup was applied to cmd.
+func HasProcessGroup(cmd *exec.Cmd) bool {
+	return cmd.SysProcAttr != nil && cmd.SysProcAttr.CreationFlags&windows.CREATE_NEW_PROCESS_GROUP != 0
+}
+
+// KillGroup force-kills pid and its whole child tree.
+func KillGroup(pid int) error {
+	if pid <= 0 {
+		return nil
+	}
+	kill := exec.Command("taskkill", "/T", "/F", "/PID", strconv.Itoa(pid))
+	kill.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, CreationFlags: windows.CREATE_NO_WINDOW}
+	err := kill.Run()
+	if err != nil {
+		if p, findErr := os.FindProcess(pid); findErr == nil {
+			_ = p.Kill()
+		}
+	}
+	return err
+}
+
+// TerminateGroup has no graceful equivalent for arbitrary trees on Windows.
+func TerminateGroup(pid int) error { return KillGroup(pid) }
+
+// HangupGroup kills the tree (no SIGHUP on Windows).
+func HangupGroup(pid int) error { return KillGroup(pid) }
+
+// Alive reports whether pid names a running process.
+func Alive(pid int) bool {
+	if pid <= 0 {
+		return false
+	}
+	h, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, uint32(pid))
+	if err != nil {
+		return errors.Is(err, windows.ERROR_ACCESS_DENIED)
+	}
+	defer windows.CloseHandle(h)
+	var code uint32
+	if windows.GetExitCodeProcess(h, &code) != nil {
+		return true
+	}
+	return code == 259 // STILL_ACTIVE
+}
+
+// Signalable reports whether pid is alive (Windows has no signal-0 probe).
+func Signalable(pid int) bool { return Alive(pid) }
+
+// TryLock takes a non-blocking exclusive lock; ErrLocked when held elsewhere.
+func TryLock(f *os.File) error {
+	ol := new(windows.Overlapped)
+	err := windows.LockFileEx(windows.Handle(f.Fd()), windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, ol)
+	if errors.Is(err, windows.ERROR_LOCK_VIOLATION) || errors.Is(err, windows.ERROR_IO_PENDING) {
+		return ErrLocked
+	}
+	return err
+}
+
+// Unlock releases a lock taken by TryLock.
+func Unlock(f *os.File) error {
+	ol := new(windows.Overlapped)
+	return windows.UnlockFileEx(windows.Handle(f.Fd()), 0, 1, 0, ol)
+}
+
+// Identity has no inode on Windows FileInfo; a stable hash of the name and
+// creation time stands in so identity checks keep working per path.
+func Identity(info os.FileInfo) (FileID, bool) {
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(info.Name()))
+	if d, ok := info.Sys().(*syscall.Win32FileAttributeData); ok {
+		_, _ = h.Write([]byte(strconv.FormatInt(d.CreationTime.Nanoseconds(), 10)))
+	}
+	return FileID{Dev: 1, Ino: h.Sum64(), Uid: 0, Nlink: 1}, true
+}
diff --git a/internal/repo/sqlite_desktop.go b/internal/repo/sqlite_desktop.go
new file mode 100644
index 0000000..7092804
--- /dev/null
+++ b/internal/repo/sqlite_desktop.go
@@ -0,0 +1,203 @@
+package repo
+
+// Desktop (single-user, single-process) storage: a SQLite file instead of
+// MySQL. Selected with a DSN of the form "sqlite:<path>" or by setting
+// AGENTFLOW_SQLITE_PATH. It reuses the exact gorm code paths the test suite
+// exercises against sqlite, and applies the public starter catalog from
+// migrations/seed on first creation (the operator step MySQL installs run).
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"agentflow/migrations"
+
+	"github.com/glebarez/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// sqlitePathFromDSN returns the database path when dsn selects SQLite.
+func sqlitePathFromDSN(dsn string) (string, bool) {
+	if p, ok := strings.CutPrefix(dsn, "sqlite:"); ok {
+		return strings.TrimSpace(p), true
+	}
+	if dsn == "" {
+		if p := strings.TrimSpace(os.Getenv("AGENTFLOW_SQLITE_PATH")); p != "" {
+			return p, true
+		}
+	}
+	return "", false
+}
+
+func openSQLite(path string) (*Store, error) {
+	if path == "" {
+		return nil, errors.New("sqlite path is empty")
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return nil, fmt.Errorf("sqlite dir: %w", err)
+	}
+	_, statErr := os.Stat(path)
+	fresh := errors.Is(statErr, os.ErrNotExist)
+	dsn := filepath.ToSlash(path) + "?_pragma=busy_timeout(15000)&_pragma=journal_mode(WAL)&_pragma=synchronous(NORMAL)"
+	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{TranslateError: true, Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		return nil, fmt.Errorf("sqlite open: %w", err)
+	}
+	if sqlDB, err := db.DB(); err == nil {
+		// One writer connection, same as the test suite: SQLite serializes
+		// writers anyway and this avoids SQLITE_BUSY between pool members.
+		sqlDB.SetMaxOpenConns(1)
+		sqlDB.SetConnMaxLifetime(0)
+	}
+	s := newStore(db)
+	if err := db.AutoMigrate(allModels()...); err != nil {
+		s.Close()
+		return nil, fmt.Errorf("sqlite automigrate: %w", err)
+	}
+	if fresh || os.Getenv("AGENTFLOW_SQLITE_RESEED") == "1" {
+		if err := seedSQLiteCatalog(db); err != nil {
+			s.Close()
+			return nil, fmt.Errorf("sqlite seed: %w", err)
+		}
+	}
+	// Desktop builds always collapse leftover docker sandbox rows, including
+	// databases created before this remap existed.
+	if os.Getenv("LOOPFORGE_DESKTOP") == "1" || os.Getenv("AGENTFLOW_DISABLE_DOCKER") == "1" {
+		if err := remapDockerSandboxesToLocal(db); err != nil {
+			s.Close()
+			return nil, fmt.Errorf("sqlite remap sandboxes: %w", err)
+		}
+	}
+	return s, nil
+}
+
+// seedSQLiteCatalog applies migrations/seed/001 (converted from MySQL) and the
+// ownerless form of the welcome project from 002.
+func seedSQLiteCatalog(db *gorm.DB) error {
+	raw, err := migrations.Seed.ReadFile("seed/001_public_catalog.sql")
+	if err != nil {
+		return err
+	}
+	stmts := mysqlSeedToSQLite(string(raw))
+	return db.Transaction(func(tx *gorm.DB) error {
+		for _, stmt := range stmts {
+			if err := tx.Exec(stmt).Error; err != nil {
+				head := stmt
+				if len(head) > 120 {
+					head = head[:120]
+				}
+				return fmt.Errorf("%w: %s", err, head)
+			}
+		}
+		now := time.Now().UTC()
+		payload := `{"id": "welcome", "key": "LOOP", "name": "LoopForge 体验项目", "description": "从创建需求、选择 SOP 到查看运行与审批，体验完整交付流程。", "color": "#3867f4", "workflowId": "welcome-workflow", "clarification": {"enabled": false}, "createdAt": "2026-10-15T00:00:00Z", "updatedAt": "2026-10-15T00:00:00Z", "ownerId": 0, "members": []}`
+		if err := tx.Exec("INSERT OR IGNORE INTO projects (id,project_key,name,owner_user_id,payload,created_at,updated_at) VALUES ('welcome','LOOP','LoopForge 体验项目',NULL,?,?,?)", payload, now, now).Error; err != nil {
+			return err
+		}
+		return remapDockerSandboxesToLocal(tx)
+	})
+}
+
+// remapDockerSandboxesToLocal rewrites catalog docker sandboxes to the local
+// driver so a desktop install never offers or starts a container runtime.
+func remapDockerSandboxesToLocal(tx *gorm.DB) error {
+	return tx.Exec(`UPDATE sandboxes
+		SET name = CASE
+			WHEN name LIKE '%本机%' THEN name
+			ELSE '本机执行（桌面版）'
+		END,
+		payload = json_set(payload, '$.driver', 'local', '$.name', '本机执行（桌面版）', '$.dockerfileId', NULL)
+		WHERE json_extract(payload, '$.driver') = 'docker'`).Error
+}
+
+// mysqlSeedToSQLite splits a MySQL seed script into statements and rewrites
+// the MySQL-only parts: INSERT IGNORE, backslash escapes inside '...' strings,
+// SET NAMES and explicit transaction statements (the caller wraps one).
+func mysqlSeedToSQLite(src string) []string {
+	var out []string
+	var b strings.Builder
+	inStr, inLineComment := false, false
+	for i := 0; i < len(src); i++ {
+		c := src[i]
+		if inLineComment {
+			if c == '\n' {
+				inLineComment = false
+				b.WriteByte(c)
+			}
+			continue
+		}
+		if inStr {
+			switch {
+			case c == '\\' && i+1 < len(src):
+				i++
+				switch n := src[i]; n {
+				case 'n':
+					b.WriteByte('\n')
+				case 't':
+					b.WriteByte('\t')
+				case 'r':
+					b.WriteByte('\r')
+				case '0':
+					b.WriteByte(0)
+				case '\'':
+					b.WriteString("''")
+				default: // \\ \" \% \_ and others: the literal character
+					b.WriteByte(n)
+				}
+			case c == '\'' && i+1 < len(src) && src[i+1] == '\'':
+				b.WriteString("''")
+				i++
+			case c == '\'':
+				inStr = false
+				b.WriteByte(c)
+			default:
+				b.WriteByte(c)
+			}
+			continue
+		}
+		if strings.HasPrefix(src[i:], "UTC_TIMESTAMP()") {
+			b.WriteString("strftime('%Y-%m-%d %H:%M:%f+00:00','now')")
+			i += len("UTC_TIMESTAMP()") - 1
+			continue
+		}
+		switch {
+		case c == '\'':
+			inStr = true
+			b.WriteByte(c)
+		case c == '-' && i+1 < len(src) && src[i+1] == '-':
+			inLineComment = true
+		case c == ';':
+			if stmt := normalizeSeedStatement(b.String()); stmt != "" {
+				out = append(out, stmt)
+			}
+			b.Reset()
+		default:
+			b.WriteByte(c)
+		}
+	}
+	if stmt := normalizeSeedStatement(b.String()); stmt != "" {
+		out = append(out, stmt)
+	}
+	return out
+}
+
+func normalizeSeedStatement(stmt string) string {
+	stmt = strings.TrimSpace(stmt)
+	upper := strings.ToUpper(stmt)
+	switch {
+	case stmt == "",
+		strings.HasPrefix(upper, "SET NAMES"),
+		strings.HasPrefix(upper, "START TRANSACTION"),
+		strings.HasPrefix(upper, "BEGIN"),
+		strings.HasPrefix(upper, "COMMIT"):
+		return ""
+	case strings.HasPrefix(upper, "INSERT IGNORE"):
+		return "INSERT OR IGNORE" + stmt[len("INSERT IGNORE"):]
+	}
+	return stmt
+}
diff --git a/internal/repo/sqlite_desktop_test.go b/internal/repo/sqlite_desktop_test.go
