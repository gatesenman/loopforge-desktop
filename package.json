{
  "name": "loopforge-desktop",
  "productName": "LoopForge",
  "version": "0.3.9",
  "description": "LoopForge \u684c\u9762\u7248\uff1a\u5b89\u88c5\u5373\u7528\uff08\u5185\u7f6e Git / Node.js / Python \u4e0e\u672c\u5730\u8fd0\u884c\u65f6\uff0c\u65e0\u9700 Docker\uff09",
  "author": "LoopForge Desktop packaging (upstream: Tencent/LoopForge, MIT)",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tencent.loopforge.desktop",
    "productName": "LoopForge",
    "artifactName": "LoopForge-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "vendor-dl/git",
        "to": "runtime/git"
      },
      {
        "from": "vendor-dl/node",
        "to": "runtime/node"
      },
      {
        "from": "vendor-dl/python",
        "to": "runtime/python"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LoopForge",
      "uninstallDisplayName": "LoopForge ${version}",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "license": "licenses/LICENSE-LoopForge.txt",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
