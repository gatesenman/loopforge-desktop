{
  "name": "loopforge-desktop",
  "productName": "LoopForge",
  "version": "0.4.2",
  "description": "LoopForge 桌面版：安装即用（内置 Git / Node.js / Python 与本地运行时，无需 Docker）",
  "author": "LoopForge Desktop packaging (upstream: Tencent/LoopForge, MIT)",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-vendors": "node scripts/fetch-vendors.js",
    "build-bins": "node scripts/build-loopforge-bins.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.js",
    "smoke:windows": "node scripts/windows-smoke.js",
    "export-source": "node scripts/export-source.js",
    "verify-package": "node scripts/verify-package.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.tencent.loopforge.desktop",
    "productName": "LoopForge",
    "artifactName": "LoopForge-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!*-linux-*",
          "!loopforge-account*"
        ]
      },
      {
        "from": "vendor-dl/git",
        "to": "runtime/git"
      },
      {
        "from": "vendor-dl/node",
        "to": "runtime/node"
      },
      {
        "from": "vendor-dl/node/node_modules",
        "to": "runtime/node/node_modules"
      },
      {
        "from": "vendor-dl/python",
        "to": "runtime/python"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LoopForge",
      "uninstallDisplayName": "LoopForge ${version}",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "license": "licenses/LICENSE-LoopForge.txt",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "gatesenman",
      "repo": "loopforge-desktop"
    }
  },
  "allowScripts": {
    "electron@45.4.1": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatesenman/loopforge-desktop.git"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
